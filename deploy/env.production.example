# Copied to .env.production by install-app.sh, which fills in the generated
# secrets. Never commit the filled-in file; it is chmod 600 and gitignored.
#
# Key names follow docs/12-security.md §2.1.

# ── identity ───────────────────────────────────────────────────────────
APP_DOMAIN=events.sunscript.tech
APP_URL=https://events.sunscript.tech
ACME_EMAIL=

# `next start` forces NODE_ENV=production, so the real environment travels
# separately. Only production and staging get the hardened defaults.
NODE_ENV=production
APP_ENV=production

# ── database ───────────────────────────────────────────────────────────
# URLs are quoted because this file is read two ways: docker compose parses it
# itself, and backup.sh sources it with `.`. An unquoted & — as in
# ?schema=public&connection_limit=10 — backgrounds the line in a shell and
# leaves the variable empty.
# The app connects as app_user: no BYPASSRLS, not the table owner. Row-level
# security applies to it, which is the second half of tenant isolation.
DATABASE_URL="postgresql://app_user:__APP_USER_PASSWORD__@postgres:5432/mixweek?schema=public&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://app_user:__APP_USER_PASSWORD__@postgres:5432/mixweek?schema=public"

# Migrations only, used by the migrator container. Owns the tables.
MIGRATION_DATABASE_URL="postgresql://app_admin:__POSTGRES_PASSWORD__@postgres:5432/mixweek?schema=public"

POSTGRES_PASSWORD=
APP_USER_PASSWORD=

# ── redis ──────────────────────────────────────────────────────────────
REDIS_URL="redis://default:__REDIS_PASSWORD__@redis:6379"
REDIS_PASSWORD=

# ── secrets ────────────────────────────────────────────────────────────
# Both 32 random bytes, base64. AUTH_SECRET signs sessions; APP_MASTER_KEY is
# the KEK that wraps every per-secret DEK.
#
# Rotating APP_MASTER_KEY: uncomment APP_MASTER_KEY_PREVIOUS with the old
# value, put the new one above, then run scripts/rewrap-secrets.ts before
# commenting it out again. Losing both makes every stored secret unrecoverable.
AUTH_SECRET=
APP_MASTER_KEY=
#APP_MASTER_KEY_PREVIOUS=

# ── proxy ──────────────────────────────────────────────────────────────
# Caddy overwrites this header on every request. Named explicitly so a
# client-supplied X-Forwarded-For is ignored for rate limiting.
TRUSTED_PROXY_HEADER=x-real-ip

# ── object storage (optional) ──────────────────────────────────────────
# Leave empty to keep uploads on the local disk. Uploads are not wired to S3
# yet — see docs/DELIVERY-NOTES.md §3.
#S3_ENDPOINT=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=

# ── mail ───────────────────────────────────────────────────────────────
# There is nothing to set here. The application sends through Resend's HTTP
# API, and the API key is an encrypted secret in the database rather than an
# environment variable — so that it can be rotated without a redeploy and is
# never readable back out (docs/12 §13).
#
# To configure it, on the server:
#
#   docker compose --env-file .env.production -f compose.production.yml \
#     run --rm -it --entrypoint '' migrator \
#     pnpm ops:rotate-secret --key=mail.resend_api_key --tenant=<tenantId>
#
# The value is read from stdin, so it never reaches your shell history. Sender
# name and address are tenant settings (mail.from_name, mail.from_email), set
# from the admin interface.
#
# Until a key is configured no mail is sent, and in production nothing is
# written to disk either — docs/12 §9 forbids links and codes leaving the
# process. Use `pnpm ops:signin-link --email=...` to let someone in meanwhile.

# ── push (optional) ────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:

# ── backups ────────────────────────────────────────────────────────────
# Backups are encrypted to an age public key. install-app.sh generates the
# keypair; the private half is backups/age.key. Copy that file into your
# password manager — without it every backup is unreadable, and a server that
# has burned down cannot supply it.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30

# Optional off-host copy: an rclone remote ("s3:bucket/path") or an rsync
# target ("user@host:/backups"). Backups kept only on this server do not
# survive losing this server.
#BACKUP_REMOTE=
