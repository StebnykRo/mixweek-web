enable-pre-post-scripts=false
node-linker=isolated
strict-peer-dependencies=false
# Do not resolve a version published in the last 7 days. A compromised
# maintainer account is usually caught within days, and nothing here needs a
# package the week it ships. Honoured by npm 11.10+; pnpm 9 ignores the key
# and warns, and will start honouring it on the upgrade to 10.16+.
min-release-age=7
