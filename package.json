{
  "name": "mixweek-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-sync-conflicts.mjs && prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:load": "tsx prisma/seed-load.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:anonymize": "tsx scripts/anonymize.ts",
    "secrets:rewrap": "tsx scripts/rewrap-secrets.ts",
    "ops:revoke-sessions": "tsx scripts/ops-revoke-sessions.ts",
    "ops:rotate-secret": "tsx scripts/ops-rotate-secret.ts",
    "ops:disable-tenant": "tsx scripts/ops-disable-tenant.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:all": "vitest run --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:load": "k6 run tests/load/push-storm.js",
    "lint": "eslint .",
    "typecheck": "node scripts/clean-sync-conflicts.mjs && tsc --noEmit",
    "audit:security": "pnpm audit --audit-level=high && node scripts/check-headers.mjs",
    "test:coverage": "vitest run --project unit --coverage",
    "clean:conflicts": "node scripts/clean-sync-conflicts.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@date-fns/tz": "^1.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.64.1",
    "blurhash": "^2.0.5",
    "bullmq": "^5.34.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.1",
    "date-fns": "^4.1.0",
    "hast-util-sanitize": "^5.0.2",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "next-intl": "^3.26.3",
    "otpauth": "^9.3.6",
    "papaparse": "^5.4.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sharp": "^0.35.0",
    "svgo": "^3.3.2",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/culori": "^2.1.1",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.18",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver",
      "@node-rs/argon2"
    ],
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "deepmerge-ts": ">=8.0.0",
      "vite": ">=6.4.3"
    }
  }
}